# Core
DEMO_MODE=true
DATABASE_URL=sqlite:///./scam_shield.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=change-me-in-production-use-long-random-string
REGION_DEFAULT=uk-example

# AI provider: auto | unorouter | groq  ("auto" uses Unorouter when its key is set)
LLM_PROVIDER=auto

# Unorouter: primary AI gateway (OpenAI-compatible). Not required when DEMO_MODE=true.
UNOROUTER_API_KEY=
UNOROUTER_BASE_URL=https://api.unorouter.com/v1
UNOROUTER_CHAT_MODEL=gemini-2.5-flash
UNOROUTER_FAST_MODEL=gemini-2.5-flash:free
UNOROUTER_VISION_MODEL=gemini-2.5-flash
UNOROUTER_STT_MODEL=whisper-large-v3-turbo:free

# Groq: optional fallback provider
GROQ_API_KEY=
GROQ_CHAT_MODEL=
GROQ_FAST_MODEL=
GROQ_VISION_MODEL=
GROQ_STT_MODEL=

# Optional safety models
ENABLE_PROMPT_GUARD=false
GROQ_PROMPT_GUARD_MODEL=

# Privacy
STORE_INPUTS=false
STORE_TRANSCRIPTS=false
MIN_REPORTS_TO_SHOW=3

# Email: console | smtp | resend
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
RESEND_API_KEY=
RESEND_FROM=Scam Shield <noreply@example.com>

# Web Push (optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Rate limits
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_LLM_PER_MINUTE=10

# Text to speech (Orpheus on Groq)
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE_CALLER=troy
GROQ_TTS_VOICE_VICTIM=hannah
PUBLIC_APP_URL=http://localhost:5173
